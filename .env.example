# PortfolioForge build-time configuration
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
# These variables are baked into the FRONTEND bundle at build time — anything
# set here is visible in the shipped JavaScript. NEVER put private API keys,
# payment secrets, or provider credentials in VITE_* variables.

# Public checkout link for the Premium upgrade button.
# Defaults to the production Lemon Squeezy checkout below, so you only need
# to set this if you switch providers/products. If changed, rebuild with
# `npm run build` so the value is baked into the bundle.
# After purchase, buyers activate Premium with the Lemon Squeezy license key
# emailed to them; the app verifies keys via Lemon Squeezy's public license
# API (no secret required).
VITE_UPGRADE_URL=https://kelvindigitaltools.lemonsqueezy.com/checkout/buy/5a9a0680-dbb4-4c1b-b38c-02c8bbd20fe1

# Displayed one-time premium price and currency (informational, shown in the
# upgrade modal). Must match the price configured in your payment provider.
VITE_PREMIUM_PRICE=$9.99
VITE_PREMIUM_CURRENCY=USD
