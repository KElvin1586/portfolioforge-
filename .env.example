# PortfolioForge build-time configuration
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
# These variables are baked into the FRONTEND bundle at build time — anything
# set here is visible in the shipped JavaScript. NEVER put private API keys,
# payment secrets, or provider credentials in VITE_* variables.

# Public checkout/payment link for the Premium upgrade button.
# 1. Create the product in your payment provider.
# 2. Create a public checkout or payment link for it.
# 3. Paste that public URL below (not a placeholder — your real link).
# 4. Rebuild with `npm run build` so the value is baked into the bundle.
# If unset, the upgrade button opens the bundled internal test page
# `/checkout.html`, which processes NO payments.
VITE_UPGRADE_URL=https://YOUR_REAL_CHECKOUT_URL

# Displayed one-time premium price and currency (informational, shown in the
# upgrade modal). Must match the price configured in your payment provider.
VITE_PREMIUM_PRICE=$9.99
VITE_PREMIUM_CURRENCY=USD
